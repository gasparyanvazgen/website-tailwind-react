{
  "name": "website-tailwind-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@heroicons/react": "^2.1.5",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.101",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:personal": "cross-env PUBLIC_URL=/ react-scripts build",
    "build:project": "cross-env PUBLIC_URL=/website-tailwind-react react-scripts build",
    "deploy:personal": "gh-pages -d build -r git@github.com:gasparyanvazgen/gasparyanvazgen.github.io.git",
    "deploy:project": "gh-pages -d build -r git@github.com:gasparyanvazgen/website-tailwind-react.git",
    "deploy:both": "npm run build:project && npm run deploy:project && npm run build:personal && npm run deploy:personal"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.4"
  }
}
